# Copy this file to ".env" and fill in your real values.
# All variables must be prefixed with VITE_ to be exposed to the app.

# --- Contact form (EmailJS) ---
# Sign up at https://www.emailjs.com/ and create an Email Service + Template.
# Until all three are set to real values, the contact form shows a
# "not configured" message instead of attempting to send.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# --- Supabase (optional) ---
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
